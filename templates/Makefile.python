# <prototype>: <one line saying what it demonstrates>.
# Target contract: STANDARDS.md section 7. Copy to <prototype>/Makefile.
# Tool versions are pinned so `make check` gives the same answer everywhere.

PYTHON ?= python3
RUFF   ?= uvx ruff@0.16.10
MYPY   ?= uvx mypy@2.4.0

.PHONY: run test lint check clean

run:
	$(PYTHON) main.py

test:
	$(PYTHON) -m unittest discover -s tests -v

lint:
	$(RUFF) check .
	$(RUFF) format --check .
	$(MYPY) --strict .

check: lint test

clean:
	rm -rf __pycache__ tests/__pycache__ .mypy_cache .ruff_cache

# --- Prototypes with third-party dependencies (uv) --------------------------
# Declare dependencies in pyproject.toml's [project] table, commit uv.lock, and
# replace the PYTHON-based recipes with:
#
#   UV ?= uv
#   # Make uv build the venv with the python3 on PATH, not one it picks itself.
#   export UV_PYTHON := $(shell command -v $(PYTHON))
#   RUN := $(UV) run --locked python
#
#   sync:
#   	$(UV) sync --locked
#   run: sync
#   	$(RUN) -m <package>.main
#   test: sync
#   	$(RUN) -m unittest discover -s tests -v
#
# and add .venv/ to clean and to .gitignore.
