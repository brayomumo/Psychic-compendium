# Whitespace rules for every file in the repo. See STANDARDS.md section 1.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.go]
indent_style = tab

[*.{c,h}]
# Google style (as used for C++): 2-space indent.
indent_size = 2

[{Makefile,Makefile.*,*.mk}]
indent_style = tab

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
